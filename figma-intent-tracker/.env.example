# Copy to .env and fill in for live mode. Demo mode needs none of these.
MODE=demo

# Apify -- both post discovery and comment extraction (required for live)
APIFY_TOKEN=
# Discovery: cookie-free Google search for linkedin.com/posts URLs
APIFY_POST_SEARCH_ACTOR=apify~google-search-scraper
# Comments: needs the LinkedIn session cookie below to return any comments
APIFY_ACTOR=scrapier~linkedin-post-comments-scraper
APIFY_COMMENT_LIMIT=30

# LinkedIn session cookie (li_at value). Required for live comment extraction:
# without it the actor runs but returns zero comments. Treat as a secret.
LINKEDIN_LI_AT=

# Anthropic -- the schema-constrained classifier (claude-haiku-4-5)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5

# Slack -- optional; if unset, surfaced leads print their payload instead of sending
SLACK_WEBHOOK_URL=
