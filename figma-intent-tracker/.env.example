# Copy to .env and fill in for live mode. Demo mode needs none of these.
MODE=demo

# Apify -- both post discovery and comment extraction (required for live).
# Both actors are cookie-free (they authenticate server-side), so no LinkedIn
# session cookie is needed.
APIFY_TOKEN=
# Discovery: cookie-free native LinkedIn post search (returns body text + comment counts)
APIFY_POST_SEARCH_ACTOR=harvestapi~linkedin-post-search
APIFY_MAX_POSTS=8
# Comments: cookie-free actor (managed auth)
APIFY_ACTOR=harvestapi~linkedin-post-comments
APIFY_COMMENT_LIMIT=40

# Anthropic -- the schema-constrained classifier (claude-haiku-4-5)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5

# Slack -- optional; if unset, surfaced leads print their payload instead of sending
SLACK_WEBHOOK_URL=
