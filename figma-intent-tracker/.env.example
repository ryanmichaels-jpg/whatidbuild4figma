# Copy to .env and fill in for live mode. Demo mode needs none of these.
MODE=demo

# Apify -- both post discovery and comment extraction (required for live)
APIFY_TOKEN=
APIFY_POST_SEARCH_ACTOR=curious_coder~linkedin-post-search-scraper
APIFY_ACTOR=scrapier~linkedin-post-comments-scraper

# Anthropic -- the schema-constrained classifier (claude-haiku-4-5)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5

# Slack -- optional; if unset, surfaced leads print their payload instead of sending
SLACK_WEBHOOK_URL=
